# Copy to .env and fill in. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: id of a webhook you created for <your-url>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Claude (console.anthropic.com > API keys)
AI_MODE=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Model calls allowed per day on this instance (protects a public demo)
AI_DAILY_CALL_LIMIT=400

# Refunds at or below this amount may run without a click, if every check passes
AUTO_REFUND_LIMIT=30.00
SUPPORT_REQUESTS_PER_HOUR=12

PORT=3000
# 127.0.0.1 locally; hosting platforms need 0.0.0.0
HOST=127.0.0.1
DATA_DIR=./data
